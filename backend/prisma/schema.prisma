// Prisma Schema for ZZIN App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 사용자
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  profileImage  String?
  phoneNumber   String?
  isKorean      Boolean   @default(true) // 한국인 인증
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  reviews       Review[]
  bookmarks     Bookmark[]
  helpfuls      ReviewHelpful[]

  @@map("users")
}

// 음식점
model Restaurant {
  id              String    @id @default(uuid())
  name            String
  nameKorean      String?   // 한글 이름
  address         String
  latitude        Float
  longitude       Float
  phoneNumber     String?
  cuisineType     String    // 음식 종류 (한식, 중식, 일식, 양식 등)
  subCuisine      String?   // 세부 종류 (한식: bbq, tofu, chicken, pocha 등)
  priceBand       String?   // 1인 가격대: u10 | 10_20 | 20_30 | 30_50 | 50_100 | 100p
  googlePlaceId   String?   @unique // Google Maps 연동
  website         String?
  hours           Json?     // 영업시간
  images          String?  // 이미지 URL 배열
  description     String?
  isVerified      Boolean   @default(false) // 검증된 정보

  // 팁 정책 (AI 웹 검색 조사 결과) + 영업 상태
  tipPolicy       String?   // no_tip | included | optional | standard | unknown
  tipConfidence   Float?    // 0~1
  tipEvidence     String?   // JSON 배열: [{ source, url, summary }]
  tipCheckedAt    DateTime?
  businessStatus  String    @default("unverified") // unverified | open | closed

  // 에디터(운영자)가 직접 정한 분류 - 시트에서 동기화. 값이 있으면 리뷰 집계보다 우선
  editorAuthenticity String?  // korean | classic | mixed | localized (본토 느낌 / 한식 스타일)
  editorExpectation  String?  // high | comfort | casual (기대치 가이드)
  editorPalateFit    String?  // good | ok | bad (한국인 입맛)
  editorPalate       String?  // JSON 배열: 입맛 포인트 (salty, rice 등)
  editorPriceValue   String?  // great | fair | poor
  editorCrowd        String?  // korean | mixed | local
  editorTip          String?  // no_tip | included | optional | standard
  editorSituations   String?  // JSON 배열: 누구랑 (family, parents, kids, date, group, solo) + noDiscrimination
  editorKeywords     String?  // JSON 배열
  editorMenus        String?  // JSON 배열
  editorOrderTip     String?  // 에디터 주문 팁
  editorNote         String?  // 에디터 한줄평
  editorSource       String?  // editor | ai (AI가 채우고 아직 검증 안 함)
  editorAiNote       String?  // AI 판단 근거
  editorUpdatedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reviews         Review[]
  tags            RestaurantTag[]
  bookmarks       Bookmark[]

  @@map("restaurants")
}

// 리뷰
model Review {
  id              String      @id @default(uuid())
  userId          String
  restaurantId    String
  rating          Float       // 1-5 별점
  content         String
  images          String?    // 리뷰 이미지들

  // 한국인 맞춤 평가 항목들
  tasteRating     Float?      // 맛 평가
  serviceRating   Float?      // 서비스 평가
  atmosphereRating Float?     // 분위기 평가

  noDiscrimination Boolean    @default(true)  // 차별 없음

  // 식당 성향 (집계해서 식당 프로필로 사용)
  authenticity    String?     // korean | classic | mixed | localized (한식: 요즘 한국 / 그 시절 / 미국식 한식)
  expectation     String?     // high | comfort | casual (기대치 가이드)
  palateFit       String?     // good | ok | bad (한국인 입맛에 맞는지)
  palate          String?     // JSON 배열: 입맛 포인트 (salty, sweet, greasy, spicy, mild, rice, soup, hangover)
  situations      String?     // JSON 배열: 누구랑 (family, parents, kids, date, group, solo)
  orderTip        String?     // 한국인을 위한 주문 팁
  priceValue      String?     // great | fair | poor (가성비)
  crowd           String?     // korean | mixed | local (주 손님층)
  keywords        String?     // JSON 배열: 한국어 주문 가능, 주차 편함 등 키워드
  tipReport       String?     // no_tip | included | optional | standard (한인이 직접 알려준 팁 정책)
  menus           String?     // JSON 배열: 추천 메뉴

  likes           Int         @default(0)
  isHelpful       Int         @default(0) // 도움됨 카운트

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  helpfuls        ReviewHelpful[]

  @@map("reviews")
}

// 태그/카테고리
model Tag {
  id              String    @id @default(uuid())
  name            String    @unique
  nameKorean      String    // 한글 태그명
  description     String?
  icon            String?   // 아이콘 이름
  category        String    // 카테고리 (상황, 음식종류, 특징 등)

  restaurants     RestaurantTag[]

  @@map("tags")
}

// 음식점-태그 매핑
model RestaurantTag {
  restaurantId    String
  tagId           String
  count           Int       @default(0) // 이 태그를 붙인 사람 수

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tag             Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([restaurantId, tagId])
  @@map("restaurant_tags")
}

// 북마크/즐겨찾기
model Bookmark {
  id              String      @id @default(uuid())
  userId          String
  restaurantId    String
  note            String?     // 개인 메모
  createdAt       DateTime    @default(now())

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@map("bookmarks")
}

// 리뷰 "도움이 됐어요"
model ReviewHelpful {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@map("review_helpfuls")
}
